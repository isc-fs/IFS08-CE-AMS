/* 0x6C2 PIT_balance_mask_a -- DCC bits for flat cells 0..63 as a 64-bit
 * LE mask (bit cell_idx). Adapter builds the mask from dcc_bits[5]. */
CAN_MSG(PIT_balance_mask_a, 0x6C2, 8, "AMS", 1000)
    FIELD_LE (dcc_mask_lo, uint64_t, 0, 64, 1, 0, "bitmask")
CAN_MSG_END(PIT_balance_mask_a)
