/* 0x6C1 PIT_timing -- mirrors ams::pit_diag::encode_timing(). clip16 in adapter. */
CAN_MSG(PIT_timing, 0x6C1, 8, "AMS", 1000)
    FIELD_BE (bms_volt_poll_ms,     uint16_t, 0, 16, 1, 0, "ms")
    FIELD_BE (bms_volt_poll_max_ms, uint16_t, 2, 16, 1, 0, "ms")
    FIELD_LE (temp_sweep_last_mask, uint32_t, 4, 32, 1, 0, "bitmask")
CAN_MSG_END(PIT_timing)
